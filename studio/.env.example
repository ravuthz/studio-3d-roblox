# Copy to .env (git-ignored) to change Film Studio settings.

# AI agents offered by "New film" to write the story and shot list, in order.
# Known agents: agy, codex, claude. Unknown names are ignored; missing CLIs show as "not installed".
STUDIO_AGENTS=agy,codex,claude

# Models offered for each agent. Unset = ask the CLI: `agy models`, `codex debug models`
# (models its picker lists); claude offers its aliases opus, sonnet, haiku, fable.
# "Default" (the CLI's own setting) is always offered first.
# STUDIO_MODELS_AGY=gemini-4-carbon-high,claude-opus-4-6-thinking
# STUDIO_MODELS_CODEX=gpt-6-luna,gpt-5.6-terra
# STUDIO_MODELS_CLAUDE=opus,sonnet,claude-opus-5-5
