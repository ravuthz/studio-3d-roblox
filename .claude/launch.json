{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pilot-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "hyperframes@0.9.22",
        "preview",
        "pilot",
        "--port=3002",
        "--no-open",
        "--foreground"
